{
  "$defs": {
    "MemoKind": {
      "enum": [
        "analytic",
        "reflexive",
        "methodological",
        "adjudication"
      ],
      "title": "MemoKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author_role": {
      "minLength": 1,
      "title": "Author Role",
      "type": "string"
    },
    "body": {
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "linked_code_ids": {
      "items": {
        "type": "string"
      },
      "title": "Linked Code Ids",
      "type": "array"
    },
    "linked_unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Linked Unit Ids",
      "type": "array"
    },
    "memo_id": {
      "minLength": 1,
      "title": "Memo Id",
      "type": "string"
    },
    "memo_kind": {
      "$ref": "#/$defs/MemoKind"
    },
    "memo_version": {
      "default": "1.0",
      "title": "Memo Version",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "study_slug": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Study Slug",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "memo_id",
    "workspace_id",
    "study_slug",
    "memo_kind",
    "title",
    "body",
    "author_role",
    "created_at"
  ],
  "title": "MemoRecord",
  "type": "object"
}
