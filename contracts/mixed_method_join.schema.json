{
  "$defs": {
    "IntegrationRelationship": {
      "enum": [
        "convergence",
        "complementarity",
        "divergence",
        "expansion"
      ],
      "title": "IntegrationRelationship",
      "type": "string"
    },
    "MixedMethodJoinRow": {
      "additionalProperties": false,
      "properties": {
        "integrated_interpretation": {
          "minLength": 1,
          "title": "Integrated Interpretation",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "qualitative_evidence": {
          "$ref": "#/$defs/QualitativeEvidenceAnchor"
        },
        "qualitative_summary": {
          "minLength": 1,
          "title": "Qualitative Summary",
          "type": "string"
        },
        "quantitative_finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Quantitative Finding Ids",
          "type": "array"
        },
        "relationship": {
          "$ref": "#/$defs/IntegrationRelationship"
        },
        "row_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Row Id",
          "type": "string"
        },
        "row_label": {
          "minLength": 1,
          "title": "Row Label",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "row_label",
        "qualitative_summary",
        "qualitative_evidence",
        "quantitative_finding_ids",
        "relationship",
        "integrated_interpretation"
      ],
      "title": "MixedMethodJoinRow",
      "type": "object"
    },
    "QualitativeEvidenceAnchor": {
      "additionalProperties": false,
      "properties": {
        "linked_code_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Code Ids",
          "type": "array"
        },
        "linked_memo_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Memo Ids",
          "type": "array"
        },
        "linked_unit_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Unit Ids",
          "type": "array"
        }
      },
      "title": "QualitativeEvidenceAnchor",
      "type": "object"
    },
    "QuantitativeFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Finding Id",
          "type": "string"
        },
        "measure_label": {
          "minLength": 1,
          "title": "Measure Label",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "source_label": {
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "subgroup_label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subgroup Label"
        },
        "text_value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Value"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "finding_id",
        "source_label",
        "measure_label"
      ],
      "title": "QuantitativeFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "codebook_ids": {
      "items": {
        "type": "string"
      },
      "title": "Codebook Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_role": {
      "minLength": 1,
      "title": "Created By Role",
      "type": "string"
    },
    "framework_matrix_ids": {
      "items": {
        "type": "string"
      },
      "title": "Framework Matrix Ids",
      "type": "array"
    },
    "join_id": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Join Id",
      "type": "string"
    },
    "join_strategy": {
      "minLength": 1,
      "title": "Join Strategy",
      "type": "string"
    },
    "join_version": {
      "default": "1.0",
      "title": "Join Version",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "quantitative_findings": {
      "items": {
        "$ref": "#/$defs/QuantitativeFinding"
      },
      "minItems": 1,
      "title": "Quantitative Findings",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/MixedMethodJoinRow"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "study_slug": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Study Slug",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "join_id",
    "workspace_id",
    "study_slug",
    "title",
    "join_strategy",
    "created_at",
    "created_by_role",
    "quantitative_findings",
    "rows"
  ],
  "title": "MixedMethodJoin",
  "type": "object"
}
