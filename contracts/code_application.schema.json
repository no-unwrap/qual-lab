      "minLength": 1,
      "title": "Application Id",
      "type": "string"
    },
    "application_version": {
      "default": "1.0",
      "title": "Application Version",
      "type": "string"
    },
    "applied_at": {
      "format": "date-time",
      "title": "Applied At",
      "type": "string"
    },
    "code_id": {
      "minLength": 1,
      "title": "Code Id",
      "type": "string"
    },
    "codebook_id": {
      "minLength": 1,
      "title": "Codebook Id",
      "type": "string"
    },
    "coder_role": {
      "minLength": 1,
      "title": "Coder Role",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
